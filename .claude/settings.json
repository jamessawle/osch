{
  "extraKnownMarketplaces": {
    "jamessawle-skills": {
      "source": {
        "source": "github",
        "repo": "jamessawle/skills"
      }
    }
  },
  "enabledPlugins": {
    "pr-management@jamessawle-skills": true
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -m:*)",
      "Bash(git reset --hard:*)",
      "Bash(git worktree:*)",
      "Bash(git checkout main)",
      "Bash(git switch main)",
      "Bash(git commit --amend:*)",
      "Bash(git rebase:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr review:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(sudo:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
